{
  "uid": "bench-headroom",
  "title": "Headroom",
  "description": "Proves the app was the bottleneck: db and loadgen CPU under 70%, Postgres healthy, no network allowance exceeded.",
  "tags": [
    "benchmark"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "benchmark"
      ],
      "asDropdown": false,
      "title": "Benchmark",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "window",
        "label": "Rate window",
        "description": "Range for rate()/increase(). Must cover >= 2 k6 remote-write pushes (K6_PROMETHEUS_RW_PUSH_INTERVAL, the runner uses 1s; k6 default 5s).",
        "query": "5s,10s,30s,1m",
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "10s",
          "value": "10s"
        },
        "options": [
          {
            "selected": false,
            "text": "5s",
            "value": "5s"
          },
          {
            "selected": true,
            "text": "10s",
            "value": "10s"
          },
          {
            "selected": false,
            "text": "30s",
            "value": "30s"
          },
          {
            "selected": false,
            "text": "1m",
            "value": "1m"
          }
        ]
      },
      {
        "type": "custom",
        "name": "host",
        "label": "Host",
        "query": "app,db,loadgen",
        "includeAll": true,
        "multi": true,
        "allValue": "app|db|loadgen",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Validity checks (the app must be the bottleneck)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "db CPU (30s avg)",
      "description": "Validity: average over the measure window must stay < 70%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",host=\"db\",mode=\"idle\"}[30s]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
