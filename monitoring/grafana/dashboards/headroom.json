    {
      "type": "stat",
      "title": "Allowance exceeded (time range)",
      "description": "Sum of all ENA *_allowance_exceeded increases on all hosts. Must be 0. 'no ENA counters' means node_exporter found none (non-ENA NIC, e.g. local dev).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum (increase(label_replace({__name__=~\"node_ethtool_.+_allowance_exceeded\",job=\"node\"}, \"counter\", \"$1\", \"__name__\", \"node_ethtool_(.+)_allowance_exceeded\")[$__range:1s]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "no ENA counters",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
